# Local: SQLite. No compose (Postgres por schema):
# DATABASE_URL=postgresql+psycopg://erp:erp@postgres:5432/erp?options=-csearch_path%3Donboarding
DATABASE_URL=sqlite:///./onboarding.db
LOG_LEVEL=INFO
PORT=8081

AUTH0_DOMAIN=dev-slbrfj6dwk1pdeox.us.auth0.com
AUTH0_AUDIENCE=https://erp-banking-api
CORS_ORIGINS=["http://localhost:5173"]

# RabbitMQ (vazio = mensageria desligada/no-op). Ex.: amqp://erp:erp@rabbitmq:5672/
RABBITMQ_URL=
# Relay do outbox: intervalo (s) para republicar eventos não publicados (<= 0 desliga)
OUTBOX_POLL_SECONDS=10
# Base do link de convite da equipe (vazio = https://erp-banking-front.vercel.app)
FRONT_URL=
# Prefixo do gateway nginx (ex.: /onboarding) para o /docs funcionar atrás dele
ROOT_PATH=

# Pool do Postgres (padrões 5/5/1800; Aiven free: use pool pequeno, ex. 3/2)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
